# 1. 定义 WebSocket 映射
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ==========================================================
# 内部转发服务器：专门处理 Lua 寻址逻辑 (绕过 HTTP/2 限制)
# ==========================================================
server {
    listen 127.0.0.1:8079; # 仅限本地访问的内部端口

    location ~ ^/(env-[^/]+) {
        set $sid $1;
        set $target_ip "";

        # 在这个 H1.1 的环境下，capture 可以正常工作
        access_by_lua_block {
            local res = ngx.location.capture("/internal_lookup?sid=" .. ngx.var.sid)
            if res.status == 200 then
                local ip = res.body:gsub("%s+", "")
                if ip ~= "" and ip ~= "NOT_FOUND" then
                    ngx.var.target_ip = ip
                else
                    ngx.exit(404)
                end
            else
                ngx.exit(502)
            end
        }

        # 真正转发给 Docker 容器
        proxy_pass http://$target_ip:7681;

        # WebSocket 支持
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 终端长连接优化
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }

    # 寻址代理 (指向 Java)
    location = /internal_lookup {
        internal;
        proxy_pass http://127.0.0.1:13232/internal/get-ip;
    }
}

# ==========================================================
# 主服务器：处理 HTTPS (HTTP/2)
# ==========================================================
server {
    listen 80;
    listen 443 ssl http2; # 这里开启了 http2
    server_name java.mlfc.moe;

    ssl_certificate /www/sites/java.mlfc.moe/ssl/fullchain.pem;
    ssl_certificate_key /www/sites/java.mlfc.moe/ssl/privkey.pem;

    # 强制 HTTPS
    if ($scheme = http) { return 301 https://$host$request_uri; }

    # --- 核心：动态容器转发 ---
    location ~ ^/(env-[^/]+) {
        # 将请求丢给本地 8079 端口进行降级处理 (从 H2 降级为 H1.1)
        proxy_pass http://127.0.0.1:8079;
        
        # 必须传递这些 Header，否则 WebSocket 握手会失败
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        proxy_buffering off;
    }

    # --- 主后端业务 (Java) ---
    location / {
        proxy_pass http://127.0.0.1:13232;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 1Panel 默认配置
    location ^~ /.well-known/acme-challenge { allow all; root /usr/share/nginx/html; }
    access_log /www/sites/java.mlfc.moe/log/access.log main;
    error_log /www/sites/java.mlfc.moe/log/error.log;
}
